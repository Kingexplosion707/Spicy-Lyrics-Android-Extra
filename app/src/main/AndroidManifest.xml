<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The always-on display asks for a face or fingerprint before showing what notifications say. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The always-on display's weather (off by default): the phone's last rough position, never GPS. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- To tell "you're offline" apart from sources failing when a lookup comes back empty. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Listening to stay in sync (Settings → Scroll & Sync → Song changes, off until switched on):
         hearing what the phone itself plays needs both. The microphone is never opened. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- The background haptics run as a foreground service while the app is not in front. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Live haptics from the microphone (music from another device). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Live haptics from the phone's own sound, through Android's audio capture. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Live haptics keep hearing with the screen off while sound plays. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Updates: the downloaded APK goes to Android's installer, which asks the user first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Only for an update downloaded out of view: Android holds its install prompt back until a tap. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16's Live Updates, for the lyrics notification's status-bar chip. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- The lyrics overlay floats over other apps; the always-on display also needs it to come up when the screen turns off. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- The always-on display's fallback without the overlay permission: a full-screen notification. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- To bring the overlay, always-on display and lyrics notification back after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Granted only through Shizuku (a shell grant): hides the status bar clock behind the status bar lyrics. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Runs on TVs too (Google TV's launcher, driven by a remote or a gamepad); a touchscreen isn't needed. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Gemini Nano (on-device translation) needs Android 8; it is only reached there (OnDeviceModel). -->
    <!-- Shizuku needs Android 7: its provider is off before that and the clock swap isn't offered. -->
    <uses-sdk tools:overrideLibrary="com.google.mlkit.genai.prompt,com.google.mlkit.genai.common,rikka.shizuku.api,rikka.shizuku.provider,rikka.shizuku.shared,rikka.shizuku.aidl" />

    <!-- Makes media players visible (Android 11+) so their custom-action icons can be loaded. -->
    <queries>
        <!-- SuperShade Plus, which shows the lyrics as a live activity in its shade. -->
        <package android:name="com.supershade" />
        <package android:name="com.supershade.debug" />
        <!-- Essentials, whose island shows the lyrics: its signing key is pinned when it's allowed. -->
        <package android:name="com.sameerasw.essentials" />
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- Player apps' names, for their delays. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application
        android:name="com.tx24.spicyplayer.SpicyLyricsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:banner="@drawable/tv_banner"
        android:theme="@style/Theme.SpicyLyricsMobile">
        <activity
            android:name="com.tx24.spicyplayer.LyricsActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:supportsPictureInPicture="true"
            android:exported="true" />

        <!--
            The launcher icons, one enabled at a time (Settings → Theme → App icon). The default
            keeps the name the activity used to have, so icons already on home screens stay.
        -->
        <activity-alias
            android:name="com.tx24.spicyplayer.MainActivity"
            android:targetActivity="com.tx24.spicyplayer.LyricsActivity"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name="com.tx24.spicyplayer.LauncherPride"
            android:targetActivity="com.tx24.spicyplayer.LyricsActivity"
            android:icon="@mipmap/ic_launcher_pride"
            android:roundIcon="@mipmap/ic_launcher_pride_round"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.tx24.spicyplayer.playback.SessionAccessService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- The live wallpaper: the now-playing screen as the home screen wallpaper. -->
        <service
            android:name="com.tx24.spicyplayer.wallpaper.SpicyWallpaperService"
            android:exported="true"
            android:label="@string/wallpaper_name"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/spicy_wallpaper" />
        </service>

        <!-- Shizuku's binder arrives through this provider once the user allows the app in Shizuku. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="@bool/shizuku_supported"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <!-- Lyrics cards handed to the share sheet (Share lyrics). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>

        <!-- The always-on display: dim lyrics on black over the lock screen. -->
        <activity
            android:name="com.tx24.spicyplayer.aod.AlwaysOnActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=".aod"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.SpicyLyricsMobile" />

        <!-- The lyrics on the Essentials island. Essentials binds it only after the user allows it
             in its Island settings, and the service answers only Essentials (signature-pinned). -->
        <service
            android:name="com.tx24.spicyplayer.island.SpicyIslandService"
            android:enabled="@bool/island_provider_supported"
            android:exported="true"
            android:label="@string/island_label"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.sameerasw.island.PROVIDER" />
            </intent-filter>
            <meta-data android:name="com.sameerasw.island.provider.label" android:value="@string/island_label" />
            <meta-data android:name="com.sameerasw.island.provider.description" android:value="@string/island_description" />
            <meta-data android:name="com.sameerasw.island.provider.priority" android:value="52" />
        </service>

        <service
            android:name="com.tx24.spicyplayer.overlay.LyricsOverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floats the lyrics of the music playing over other apps" />
        </service>

        <service
            android:name="com.tx24.spicyplayer.aod.AlwaysOnService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the lyrics as an always-on display when the screen turns off" />
        </service>

        <activity
            android:name="com.tx24.spicyplayer.wallpaper.WallpaperSettingsActivity"
            android:exported="false"
            android:label="@string/wallpaper_name"
            android:theme="@style/Theme.SpicyLyricsMobile" />

        <!-- The background haptics: a foreground service, so the vibrations keep going with the music while the app is not in front. -->
        <service
            android:name="com.tx24.spicyplayer.haptics.BackgroundHapticsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Live haptics: vibrating to the phone's own sound or the microphone, when there's no song analysis. -->
        <service
            android:name="com.tx24.spicyplayer.haptics.LiveHapticsService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback|microphone|mediaProjection" />

        <!-- The lyrics notification: the line being sung, for islands and Live Updates. -->
        <service
            android:name="com.tx24.spicyplayer.playback.LyricsNotificationService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Shows the lyric line being sung as an ongoing notification" />
        </service>

        <!-- The sleep timer: pauses the player after a set time or at the end of the song. -->
        <service
            android:name="com.tx24.spicyplayer.playback.SleepTimerService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Pauses the music playing in another app when a sleep timer runs out" />
        </service>

        <!-- Quick Settings tiles for the overlay and the always-on display. -->
        <service
            android:name="com.tx24.spicyplayer.tiles.OverlayTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_overlay"
            android:label="@string/tile_overlay"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
        <service
            android:name="com.tx24.spicyplayer.tiles.AlwaysOnTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_aod"
            android:label="@string/tile_aod"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            tools:targetApi="n">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- Brings the overlay, always-on display and lyrics notification back after a restart or an update. -->
        <receiver
            android:name="com.tx24.spicyplayer.tiles.StartupReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <activity
            android:name="com.tx24.spicyplayer.widget.WidgetSettingsActivity"
            android:exported="true"
            android:label="@string/widget_settings"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SpicyLyricsMobile">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.tx24.spicyplayer.widget.LyricsWidget"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/lyrics_widget_info" />
        </receiver>

        <receiver
            android:name="com.tx24.spicyplayer.update.UpdateInstallReceiver"
            android:exported="false" />
        <!-- Spotify's sign-in page comes back here (Settings → Device → Always-on display). -->
        <activity
            android:name="com.tx24.spicyplayer.spotify.SpotifyLoginActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="spicylyricsplus" android:host="callback" />
            </intent-filter>
        </activity>
        <!-- Settings → Device → Always-on display: set where the fingerprint sensor is by touching it. -->
        <activity
            android:name="com.tx24.spicyplayer.aod.FingerprintSpotActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
        <!-- Live haptics: asks Android again to capture the phone's sound, from the notification. -->
        <activity
            android:name="com.tx24.spicyplayer.haptics.CaptureConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- SuperShade Plus asks for the lyrics for its live activity, and to float them out as the overlay. -->
        <receiver
            android:name="com.tx24.spicyplayer.shade.SuperShadeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.behnoud.spicylyrics.action.SHADE_REQUEST" />
                <action android:name="com.behnoud.spicylyrics.action.SHADE_STOP" />
                <action android:name="com.behnoud.spicylyrics.action.SHADE_OVERLAY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
