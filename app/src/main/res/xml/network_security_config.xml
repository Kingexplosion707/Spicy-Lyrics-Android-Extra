<?xml version="1.0" encoding="utf-8"?>
<!-- Music Assistant servers usually answer over plain http on the home network (and some use a
     certificate the user installed), so both are allowed, as in Music Assistant's own app. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
